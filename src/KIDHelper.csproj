<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>KIDHelper</AssemblyName>
    <RootNamespace>KidHelper</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>

    <Product>KID Helper</Product>
    <AssemblyTitle>KID Helper - Keyword Item Distributor ini generator</AssemblyTitle>
    <Description>Generate _KID.ini lines from Skyrim plugins</Description>
    <Version>1.0.0</Version>

    <!-- single .exe that runs without installing .NET -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>
</Project>
